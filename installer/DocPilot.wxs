<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="DocPilot 公文小幫手" Manufacturer="DocPilot" Version="1.1.0" UpgradeCode="c75f3d61-6e4d-49fa-b01c-6e0c748948c1" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="已安裝較新版本。" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="assets\docpilot.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <StandardDirectory Id="LocalAppDataFolder"><Directory Id="INSTALLFOLDER" Name="DocPilotApp" /></StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Directory Id="ProgramMenuDir" Name="DocPilot" /></StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="..\dist\DocPilot\**" />
    </ComponentGroup>
    <DirectoryRef Id="ProgramMenuDir">
      <Component Id="Shortcuts" Guid="a3b5e823-b82b-4d8b-a151-5619f4b60aa8">
        <Shortcut Id="StartShortcut" Name="DocPilot 公文小幫手" Target="[INSTALLFOLDER]DocPilot.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="DocPilot 公文小幫手" Target="[INSTALLFOLDER]DocPilot.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RemoveFolder Id="RemoveMenu" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\DocPilot" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <Feature Id="Main"><ComponentGroupRef Id="ApplicationFiles" /><ComponentRef Id="Shortcuts" /></Feature>
  </Package>
</Wix>

